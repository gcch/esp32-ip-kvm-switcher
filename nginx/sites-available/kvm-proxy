server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/ssl/server.pem;
    ssl_certificate_key /etc/nginx/ssl/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    location = /kvm-inject.js {
        root /etc/nginx/static;
        add_header Content-Type "application/javascript; charset=utf-8";
        add_header Cache-Control "no-cache";
    }

    location /esp32/ {
        proxy_pass http://kvm-switch1.local/;  # Your ESP32 Address
        proxy_http_version 1.1;
        proxy_set_header Host kvm-switch1.local;  # Your ESP32 Address
        proxy_set_header Authorization "Basic dXNlcjpwYXNz==";  # Your ESP32 Authentication string "${auth_user}:${auth_password}" encoded by base64
        proxy_set_header X-Real-IP $remote_addr;

        add_header Access-Control-Allow-Origin "*";
    }

    location / {
        proxy_pass https://kvm1.local;  # Your JetKVM Address
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        proxy_set_header Accept-Encoding "";

        sub_filter '</body>' '<script src="/kvm-inject.js"></script></body>';
        sub_filter_once on;
    }
}