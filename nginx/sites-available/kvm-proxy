map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    server_name _;
    ssl_certificate     /etc/nginx/ssl/server.pem;
    ssl_certificate_key /etc/nginx/ssl/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    location = /kvm-inject.js {
        root /etc/nginx/static;
        add_header Content-Type "application/javascript; charset=utf-8";
        add_header Cache-Control "no-cache";
    }

    location /esp32/ {
        proxy_pass http://kvm-switch1.local/;
        proxy_http_version 1.1;
        proxy_set_header Host kvm-switch1.local;
        proxy_set_header Authorization "Basic dXNlcjpwYXNz==";
        proxy_set_header X-Real-IP $remote_addr;
        add_header Access-Control-Allow-Origin "*";
    }

    location / {
        proxy_pass https://kvm1.local;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Accept-Encoding "";

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        sub_filter '</body>' '<script src="/kvm-inject.js"></script></body>';
        sub_filter_once on;
    }
}
